# development | test | production
NODE_ENV=development
PORT=3000
# 0.0.0.0 di container/server; 127.0.0.1 agar hanya bisa diakses dari mesin sendiri
HOST=127.0.0.1

# PostgreSQL (docker compose service `db`)
DATABASE_URL=postgres://mafaaza:mafaaza@localhost:5432/mafaaza
# Supabase: runtime lewat pooler mode transaksi (IPv4, port 6543) -- ganti [YOUR-PASSWORD] hanya di .env
# DATABASE_URL="postgresql://postgres.ginaiawcuoaybsxqnfjr:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require"
# Pooler mode transaksi tidak mendukung prepared statement
# DATABASE_PREPARE=false
# Migrasi & drizzle-kit lewat pooler mode sesi (port 5432); kosong = pakai DATABASE_URL
# DATABASE_MIGRATION_URL="postgresql://postgres.ginaiawcuoaybsxqnfjr:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require"
# Dipakai oleh `bun test` (docker compose service `db-test`)
TEST_DATABASE_URL=postgres://mafaaza:mafaaza@localhost:5433/mafaaza_test

# Minimal 32 karakter. Buat dengan: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Origin frontend dashboard, dipisah koma
CORS_ORIGINS=http://localhost:5173

# Set false untuk mematikan /openapi di production
OPENAPI_ENABLED=true

# Lokasi penyimpanan bukti pengeluaran
UPLOAD_DIR=./storage/uploads

# true bila berjalan di balik reverse proxy yang mengisi X-Forwarded-For
TRUST_PROXY=false

# Hanya untuk `bun run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Admin Toko
