{
  "name": "mafaaza-api",
  "version": "1.0.50",
  "private": true,
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed": "bun src/db/seed.ts",
    "admin:reset-password": "bun src/scripts/reset-password.ts",
    "test": "bun test tests/unit tests/integration",
    "test:unit": "bun test tests/unit",
    "test:perf": "bun test ./tests/perf/reports.perf.ts --timeout 600000"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/openapi": "1.4.16",
    "@sinclair/typebox": "0.34.52",
    "drizzle-orm": "0.45.3",
    "elysia": "1.4.30",
    "jose": "6.2.12",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
